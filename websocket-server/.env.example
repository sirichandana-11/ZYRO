# ZYRO WebSocket Server Configuration

PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# Location Throttling
LOCATION_UPDATE_INTERVAL_MS=2500
LOCATION_MIN_DISTANCE_METERS=10

# Matching Configuration
MATCHING_RADIUS_KM=10

# Firebase Configuration
FIREBASE_PROJECT_ID=zyro-ride
# FIREBASE_SERVICE_ACCOUNT=./serviceAccountKey.json

# Redis Configuration (Optional - for multi-instance production clustering)
# REDIS_HOST=localhost
# REDIS_PORT=6379
