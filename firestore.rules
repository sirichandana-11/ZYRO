rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isRider() {
      return isAuthenticated() && (getUserData().role == 'rider' || !exists(/databases/$(database)/documents/users/$(request.auth.uid)));
    }

    function isDriver() {
      return isAuthenticated() && getUserData().role == 'driver';
    }

    // 1. Users collection: authoritative role and user metadata (Role is immutable on update)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role);
      allow delete: if false;

      // Saved Places subcollection (strictly owner access)
      match /savedPlaces/{placeId} {
        allow read, write: if isOwner(userId);
      }

      // Payment Methods metadata subcollection (strictly owner access)
      match /paymentMethods/{methodId} {
        allow read, write: if isOwner(userId);
      }

      // Preferences subcollection (notifications, app preferences)
      match /preferences/{prefId} {
        allow read, write: if isOwner(userId);
      }
    }

    // 2. Drivers collection: driver profiles, live GPS, availability
    match /drivers/{driverId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(driverId);
    }

    // 3. Rides collection: high-speed 120s ride allocation
    match /rides/{rideId} {
      // Any authenticated user can read ride states (riders and eligible drivers)
      allow read: if isAuthenticated();

      // Riders can create a searching ride with their own riderId
      allow create: if isAuthenticated() && (request.resource.data.riderId == request.auth.uid || request.resource.data.riderId.size() > 0);

      // Updating rides:
      // 1. Rider can cancel their own ride or rate their completed ride
      // 2. Driver can accept ride via atomic transaction setting driverId to their authenticated UID
      // 3. Driver can advance active ride lifecycle (arrived, started, completed)
      // 4. Timeout transaction transitions searching -> driver_assigned (backup) or no_driver
      allow update: if isAuthenticated() && (
        // Rider cancelling their own ride or rating completed ride
        (resource.data.riderId == request.auth.uid && (request.resource.data.status == 'cancelled' || (resource.data.status == 'completed' && request.resource.data.rating != null))) ||
        // Driver accepting or updating their active assignment
        (request.resource.data.driverId == request.auth.uid || resource.data.driverId == request.auth.uid) ||
        // 120-second timeout transition for searching ride
        (resource.data.status == 'searching' && request.resource.data.status in ['driver_assigned', 'no_driver'])
      );

      allow delete: if false;
    }

    // 4. Ratings collection: post-ride ratings and feedback
    match /ratings/{ratingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.riderId == request.auth.uid &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5;
      allow update, delete: if false;
    }
  }
}
